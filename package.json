{
  "name": "stashly",
  "version": "1.0.0",
  "description": "Personal Savings and Wishlist Tracking Desktop Application",
  "main": "dist-electron/main.js",
  "author": "Stashly Team",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:vite && npm run build:electron",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@types/canvas-confetti": "^1.9.0",
    "better-sqlite3": "^11.8.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
